<header>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script type="module" src="/theme.js"></script>
    <div class="header-container">
        {{> partials/logo }}
        {{> partials/navbar }}
        <a href="https://github.com/FreezeTagPhoto/FreezeTag">
            <img src="/assets/Github_Invertocat_Black.svg" alt="Github Logo and Link"
                class="icon github-icon">
        </a>
        <button class="header-theme-button">
            <img src="/assets/theme-icon.svg" class="header-theme-button-icon icon">
        </button>
    </div>
</header>